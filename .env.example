# --- Cloudinary (Lahore heritage postcards) ---------------------------------------------
# Public: safe to expose in the browser (used to build delivery URLs).
PUBLIC_CLOUDINARY_CLOUD_NAME=
# Folder that holds the heritage assets (seeded as <folder>/<landmark>/<slot>).
PUBLIC_CLOUDINARY_FOLDER=lahore-heritage
# "upload" = deliver assets seeded with `pnpm cloudinary:seed` (recommended)
# "fetch"  = let Cloudinary fetch the Wikimedia Commons originals on the fly
#            (requires "Fetched URL" to be unrestricted in Console > Settings > Security)
PUBLIC_CLOUDINARY_DELIVERY=upload

# Private: server only. Used by the seed script, /api/heritage (Search API) and
# /api/heritage/sign (signed visitor uploads). Never prefix these with PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
